# Video and attachment storage. Set in production (Vercel → Storage → Blob).
# Left empty, uploads are written to ./.uploads and served from /api/files —
# fine for local work, useless on a serverless host with a read-only disk.
BLOB_READ_WRITE_TOKEN=""
